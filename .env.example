# Public site URL (production) — must match your Vercel domain for SEO + social previews
NEXT_PUBLIC_SITE_URL=https://voxgraph-web.vercel.app

# Your Render backend WebSocket (online try)
NEXT_PUBLIC_VOXGRAPH_ONLINE_WS_URL=wss://YOUR-SERVICE.onrender.com/audio

# Local backend for dev (local try on /try)
NEXT_PUBLIC_VOXGRAPH_WS_URL=ws://127.0.0.1:8001/audio

# Creator attribution (footer, SEO, /about page)
NEXT_PUBLIC_AUTHOR_NAME=Surya Raj
